---
// ============================================
// BaseLayout — SEO-optimized HTML5 boilerplate
// Change theme by switching the CSS import below:
//   "theme-professional-light"  → clean, corporate
//   "theme-dark-tech"           → dark, tech-forward
//   "theme-warm-minimal"        → warm, organic
// ============================================
import '../styles/global.css';
import '../styles/theme-dark-tech.css'; // ← CHANGE THEME HERE

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
}

const {
  title,
  description,
  canonical = 'https://info1.igorp.com/',
  ogImage = '/og-image.png',
  ogType = 'website',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const imageUrl = `https://info1.igorp.com${base}${ogImage}`;
const fullTitle = `${title} | Igor Pankin`;
const keywords = 'Igor Pankin, Finance Systems, ERP, Oracle ERP Cloud, Oracle E-Business Suite, Product Owner, Delivery Manager, Project Management, SaaS, PaaS, Integrations, P&L, Pre-sales, FinTech, Limassol, Cyprus, AI agents';
const schemaOrg = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Igor Pankin",
  "givenName": "Igor",
  "familyName": "Pankin",
  "jobTitle": "Finance Systems & ERP Product Lead",
  "description": "Finance systems and ERP product and delivery lead with 20 years in Oracle E-Business Suite and Oracle ERP Cloud: implementation, SaaS/PaaS, integrations, P&L and pre-sales. AI-agent automation on the side.",
  "url": "https://info1.igorp.com/",
  "sameAs": [
    "https://www.linkedin.com/in/igorpankin/",
    "https://github.com/vespexx",
    "https://www.strava.com/athletes/461770"
  ],
  "knowsAbout": [
    "Oracle ERP Cloud",
    "Oracle E-Business Suite",
    "Financial systems",
    "ERP implementation",
    "SaaS and PaaS development",
    "System integration",
    "Project and delivery management",
    "Pre-sales",
    "AI agents"
  ],
  "alumniOf": { "@type": "CollegeOrUniversity", "name": "Lomonosov Moscow State University" },
  "worksFor": {
    "@type": "Organization",
    "name": "Softline Group (Borlas Group)"
  },
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Limassol",
    "addressCountry": "CY"
  }
};
---

<!DOCTYPE html>
<html lang="en" class="theme-dark-tech">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <!-- Primary Meta Tags -->
  <title>{fullTitle}</title>
  <meta name="title" content={fullTitle} />
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <meta name="author" content="Igor Pankin" />
  <meta name="robots" content="index, follow" />
  <meta name="language" content="English" />

  <!-- Canonical URL -->
  <link rel="canonical" href={canonical} />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:site_name" content="Igor Pankin" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonical} />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageUrl} />

  <!-- LinkedIn specific -->
  <meta property="linkedin:profile" content="https://www.linkedin.com/in/igorpankin/" />

  <!-- Schema.org structured data -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  <link rel="alternate icon" href={`${base}/favicon.ico`} />

  <!-- Preconnect for performance -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />


  <!-- Theme color for browser chrome -->
  <meta name="theme-color" content="#0a0a1a" />
  <meta name="msapplication-TileColor" content="#0a0a1a" />
</head>
<body>
  <slot />
</body>
</html>
