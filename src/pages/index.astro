---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import WorkTimeline from '../components/WorkTimeline.astro';
import Achievements from '../components/Achievements.astro';
import Skills from '../components/Skills.astro';
import AgentProjects from '../components/AgentProjects.astro';
import SportsStats from '../components/SportsStats.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Igor Pankin — Finance Systems & ERP Product Lead"
  description="Igor Pankin — Finance Systems & ERP Product Lead in Limassol, Cyprus. 20 years in financial ERP (Oracle) and FinTech delivery, plus AI-agent automation projects."
  canonical="https://igorp.com"
  ogImage="/og-image.png"
>
  <Header />
  <main>
    <Hero />
    <WorkTimeline />
    <Achievements />
    <Skills />
    <AgentProjects />
    <SportsStats />
    <ContactCTA />
  </main>
  <Footer />
</BaseLayout>
