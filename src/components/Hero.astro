---
import workData from '../content/work.json';
const { name, headline, tagline, roles, image, linkedin, github } = workData;
---

<section id="hero" class="hero section">
  <div class="container">
    <div class="hero__grid">
      <div class="hero__content animate-in">
        <div class="hero__badge">Open to Opportunities</div>
        <h1 class="hero__name">{name}</h1>
        <h2 class="hero__headline">{headline}</h2>
        <p class="hero__tagline">{tagline}</p>
        <div class="hero__roles">
          {roles.slice(0, 3).map((role) => (
            <span class="hero__role">{role}</span>
          ))}
        </div>
        <div class="hero__actions">
          <a href="#work" class="btn btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            View My Work
          </a>
          <a href={github} target="_blank" class="btn btn-outline">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            GitHub
          </a>
        </div>
      </div>
      <div class="hero__visual animate-in animate-in-delay-2">
        <div class="hero__avatar-wrapper">
          <div class="hero__avatar-glow"></div>
          <div class="hero__avatar">
            <svg width="280" height="280" viewBox="0 0 280 280" fill="none" xmlns="http://www.w3.org/2000/svg">
              <!-- Placeholder avatar — replace with actual image -->
              <rect width="280" height="280" rx="140" fill="url(#avatarGrad)" />
              <circle cx="140" cy="112" r="48" fill="rgba(255,255,255,0.2)" />
              <ellipse cx="140" cy="212" rx="64" ry="52" fill="rgba(255,255,255,0.15)" />
              <defs>
                <linearGradient id="avatarGrad" x1="0" y1="0" x2="280" y2="280">
                  <stop offset="0%" stop-color="var(--color-accent)" />
                  <stop offset="100%" stop-color="var(--color-accent-hover)" />
                </linearGradient>
              </defs>
            </svg>
          </div>
        </div>
        <div class="hero__status-dots">
          <span class="hero__dot"></span>
          <span class="hero__dot"></span>
          <span class="hero__dot"></span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 80px;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: var(--color-accent-gradient);
    opacity: 0.03;
    pointer-events: none;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .hero__badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 6px 16px;
    border-radius: 20px;
    background: var(--color-accent-light);
    color: var(--color-accent);
    margin-bottom: 20px;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
  }

  .hero__name {
    margin-bottom: 8px;
  }

  .hero__headline {
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: 16px;
  }

  .hero__tagline {
    font-size: 1.05rem;
    margin-bottom: 24px;
    max-width: 540px;
  }

  .hero__roles {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 32px;
  }

  .hero__role {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 4px 14px;
    border-radius: 20px;
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
  }

  .hero__actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .hero__visual {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }

  .hero__avatar-wrapper {
    position: relative;
    width: 280px;
    height: 280px;
  }

  .hero__avatar-glow {
    position: absolute;
    inset: -20px;
    border-radius: 50%;
    background: var(--color-accent-gradient);
    opacity: 0.15;
    filter: blur(30px);
    animation: glowPulse 3s ease-in-out infinite alternate;
  }

  @keyframes glowPulse {
    from { opacity: 0.1; transform: scale(0.95); }
    to { opacity: 0.2; transform: scale(1.05); }
  }

  .hero__avatar {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid var(--color-border);
    box-shadow: 0 16px 48px var(--color-shadow);
  }

  .hero__status-dots {
    display: flex;
    gap: 8px;
  }

  .hero__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
    opacity: 0.3;
    animation: dotPulse 1.5s ease-in-out infinite;
  }

  .hero__dot:nth-child(2) { animation-delay: 0.3s; }
  .hero__dot:nth-child(3) { animation-delay: 0.6s; }

  @keyframes dotPulse {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 0.8; }
  }

  @media (max-width: 768px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 40px;
      text-align: center;
    }
    .hero__tagline {
      max-width: 100%;
    }
    .hero__actions {
      justify-content: center;
    }
    .hero__roles {
      justify-content: center;
    }
    .hero__avatar-wrapper {
      width: 200px;
      height: 200px;
    }
  }
</style>
