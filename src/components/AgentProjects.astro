---
import projects from '../content/agent-projects.json';
---

<section id="agent-dev" class="section section-alt">
  <div class="container">
    <div class="section-label animate-in">04 / Side projects — AI automation</div>
    <h2 class="section-title animate-in animate-in-delay-1">AI-Agent Automation Projects</h2>
    <p class="section-subtitle animate-in animate-in-delay-2">Building autonomous agent systems, automation pipelines, and developer tools. All four run in production for my own use; the code is in private repositories.</p>

    <div class="projects-grid">
      {projects.map((project, i) => (
        <article class="project-card card animate-in" style={`animation-delay: ${0.08 * (i + 1)}s`}>
          <div class="project-card__header">
            <div class="project-card__icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
              </svg>
            </div>
            <div class="project-card__info">
              <h3 class="project-card__name">{project.name}</h3>
              <span class="project-card__language">{project.title}</span>
            </div>
          </div>
          <p class="project-card__description">{project.description}</p>
          <ul class="project-card__highlights">
            {project.highlights.map((h) => (
              <li class="project-card__highlight">{h}</li>
            ))}
          </ul>
          <ul class="project-card__stack" aria-label="Technologies">
            {project.stack.map((t) => (
              <li class="project-card__chip">{t}</li>
            ))}
          </ul>
          <p class="project-card__shows"><strong>Shows:</strong> {project.shows}</p>
        </article>
      ))}
    </div>
    <p class="projects-note">Repositories are private; architecture walkthrough and code samples on request.</p>
  </div>
</section>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .project-card__header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 14px;
  }

  .project-card__icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: var(--color-accent-light);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .project-card__info {
    min-width: 0;
  }

  .project-card__name {
    font-size: 1rem;
    font-weight: 600;
  }

  .project-card__name a {
    color: var(--color-text);
    text-decoration: none;
  }

  .project-card__name a:hover {
    color: var(--color-accent);
  }

  .project-card__language {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .project-card__description {
    font-size: 0.9rem;
    margin-bottom: 16px;
    line-height: 1.7;
  }

  .project-card__highlights {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 20px;
  }

  .project-card__highlight {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    padding-left: 16px;
    position: relative;
  }

  .project-card__highlight::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }

  .project-card__stack {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 14px;
  }

  .project-card__chip {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 3px 10px;
    border-radius: 20px;
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
  }

  .project-card__shows {
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  .projects-note {
    margin-top: 20px;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-align: center;
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
